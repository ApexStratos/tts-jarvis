[{"id":"communications_gateway_tool","user_id":"713408df-bb82-4297-99af-3be743f48992","name":"Communications Gateway Tool","meta":{"description":"A tool to send SMS and initiate voice calls via the LLM Communications Gateway (https://github.com/ther3zz/llm-communications-gateway)","manifest":{"title":"Communications Gateway Tool","author":"reptar(rezz)","version":"0.11.1","license":"MIT","description":"Supports SMS, Voice calls, Status Checks, and Call Logs. See LLM-Communications-Gateway: https://github.com/ther3zz/llm-communications-gateway"},"has_user_valves":false},"access_grants":[],"updated_at":1784932717,"created_at":1784932717,"user":null,"write_access":true,"content":"\"\"\"\ntitle: Communications Gateway Tool\nauthor: reptar(rezz)\nversion: 0.11.1\nlicense: MIT\ndescription: Supports SMS, Voice calls, Status Checks, and Call Logs. See LLM-Communications-Gateway: https://github.com/ther3zz/llm-communications-gateway\n\"\"\"\n\nimport requests\nimport re\nimport json\nfrom pydantic import BaseModel, Field\nfrom typing import Optional, Callable, Awaitable, List, Dict, Any\n\n\nclass Tools:\n    class Valves(BaseModel):\n        gateway_url: str = Field(\n            default=\"http://host.docker.internal:8000\",\n            description=\"The base URL where the llm-communications-gateway is running. Use host.docker.internal if running in Docker.\",\n        )\n        default_voice_provider: str = Field(\n            default=\"telnyx\",\n            description=\"The provider name to use for voice calls (e.g., 'telnyx', 'twilio').\",\n        )\n        default_sms_provider: Optional[str] = Field(\n            default=None,\n            description=\"The provider name to use for SMS. If left empty, the gateway's default logic is used.\",\n        )\n\n    def __init__(self):\n        self.valves = self.Valves()\n\n    def _sanitize_phone_number(self, phone: str) -> str:\n        if not phone:\n            return \"\"\n        cleaned = re.sub(r\"[^0-9+]\", \"\", phone)\n        if cleaned.startswith(\"+11\") and len(cleaned) == 13:\n            return \"+1\" + cleaned[3:]\n        if cleaned.startswith(\"11\") and len(cleaned) == 12:\n            return \"+1\" + cleaned[2:]\n        if not cleaned.startswith(\"+\"):\n            if len(cleaned) == 10:\n                return \"+1\" + cleaned\n            if len(cleaned) == 11 and cleaned.startswith(\"1\"):\n                return \"+\" + cleaned\n            return \"+\" + cleaned\n        return cleaned\n\n    def _resolve_chat_id(self, conversation_id: str, chat_id: str, request: Any) -> str:\n        candidates = [conversation_id, chat_id]\n        for c in candidates:\n            if c and c not in [\"current_conversation\", \"unknown\", \"None\", None]:\n                return c\n\n        if request:\n            try:\n                if hasattr(request, \"_json\") and isinstance(request._json, dict):\n                    metadata = request._json.get(\"metadata\", {})\n                    if \"chat_id\" in metadata:\n                        return metadata[\"chat_id\"]\n                if hasattr(request, \"state\") and hasattr(request.state, \"chat_id\"):\n                    return request.state.chat_id\n                if hasattr(request, \"headers\"):\n                    cid = request.headers.get(\"X-Conversation-Id\")\n                    if cid:\n                        return cid\n                    referer = request.headers.get(\"referer\", \"\")\n                    match = re.search(r\"/c/([a-f0-9\\-]{36})\", referer)\n                    if match:\n                        return match.group(1)\n            except Exception:\n                pass\n        return \"unknown_chat_id\"\n\n    def _format_dict_to_markdown_table(self, data: List[Dict[str, Any]]) -> str:\n        if not data:\n            return \"No records found.\"\n        headers = list(data[0].keys())\n        # Added cost, duration, transcription to preferred order for call logs\n        preferred_order = [\n            \"created_at\",\n            \"timestamp\",\n            \"to_number\",\n            \"from_number\",\n            \"direction\",\n            \"status\",\n            \"duration_seconds\",\n            \"cost\",\n            \"transcription\",\n        ]\n        sorted_headers = sorted(\n            headers,\n            key=lambda x: preferred_order.index(x) if x in preferred_order else 999,\n        )\n\n        md = (\n            \"| \"\n            + \" | \".join([h.replace(\"_\", \" \").title() for h in sorted_headers])\n            + \" |\\n\"\n        )\n        md += \"| \" + \" | \".join([\"---\"] * len(sorted_headers)) + \" |\\n\"\n\n        for row in data:\n            values = []\n            for h in sorted_headers:\n                val = str(row.get(h, \"\"))\n                # Remove newlines to prevent breaking the markdown table\n                val = val.replace(\"\\n\", \" \")\n                if len(val) > 50:\n                    val = val[:47] + \"...\"\n                values.append(val)\n            md += \"| \" + \" | \".join(values) + \" |\\n\"\n        return md\n\n    async def send_sms(\n        self,\n        to_number: str,\n        message: str,\n        __user__: dict = {},\n        __conversation_id__: str = None,\n        __chat_id__: str = None,\n        __request__: Any = None,\n        __event_emitter__: Callable[[dict], Awaitable[None]] = None,\n    ) -> str:\n        \"\"\"\n        Sends an SMS text message.\n        \"\"\"\n        sanitized_number = self._sanitize_phone_number(to_number)\n        user_id = __user__.get(\"id\", \"unknown\")\n        chat_id = self._resolve_chat_id(__conversation_id__, __chat_id__, __request__)\n\n        url = f\"{self.valves.gateway_url.rstrip('/')}/api/sms/send\"\n\n        if __event_emitter__:\n            await __event_emitter__(\n                {\n                    \"type\": \"status\",\n                    \"data\": {\n                        \"status\": \"in_progress\",\n                        \"description\": f\"Sending SMS to {sanitized_number}...\",\n                        \"done\": False,\n                    },\n                }\n            )\n\n        payload = {\n            \"to_number\": sanitized_number,\n            \"message\": message,\n            \"user_id\": user_id,\n            \"chat_id\": chat_id,\n        }\n        if self.valves.default_sms_provider:\n            payload[\"provider\"] = self.valves.default_sms_provider\n\n        try:\n            print(f\"DEBUG: Sending SMS payload: {json.dumps(payload)}\")\n            response = requests.post(url, json=payload, timeout=10)\n            response.raise_for_status()\n            data = response.json()\n\n            if data.get(\"success\") is False:\n                raise Exception(f\"Gateway rejected request: {data.get('error')}\")\n\n            msg_id = data.get(\"message_id\", \"Confirmed\")\n\n            if __event_emitter__:\n                await __event_emitter__(\n                    {\n                        \"type\": \"message\",\n                        \"data\": {\n                            \"content\": f\"\\n\\n> ✅ **SMS Sent Successfully**\\n> **To:** {sanitized_number}\\n> **ID:** `{msg_id}`\\n\"\n                        },\n                    }\n                )\n                await __event_emitter__(\n                    {\n                        \"type\": \"status\",\n                        \"data\": {\n                            \"status\": \"complete\",\n                            \"description\": \"SMS Sent\",\n                            \"done\": True,\n                        },\n                    }\n                )\n            return json.dumps(data)\n\n        except Exception as e:\n            if __event_emitter__:\n                await __event_emitter__(\n                    {\n                        \"type\": \"status\",\n                        \"data\": {\n                            \"status\": \"error\",\n                            \"description\": \"Failed\",\n                            \"done\": True,\n                        },\n                    }\n                )\n            return f\"Error: {str(e)}\"\n\n    async def initiate_voice_call(\n        self,\n        to_number: str,\n        prompt: str,\n        __user__: dict = {},\n        __conversation_id__: str = None,\n        __chat_id__: str = None,\n        __request__: Any = None,\n        __event_emitter__: Callable[[dict], Awaitable[None]] = None,\n    ) -> str:\n        \"\"\"\n        Initiates an outbound voice call/TTS alert.\n        \"\"\"\n        sanitized_number = self._sanitize_phone_number(to_number)\n        user_id = __user__.get(\"id\", \"unknown\")\n        chat_id = self._resolve_chat_id(__conversation_id__, __chat_id__, __request__)\n\n        url = f\"{self.valves.gateway_url.rstrip('/')}/api/voice/call\"\n\n        if __event_emitter__:\n            await __event_emitter__(\n                {\n                    \"type\": \"status\",\n                    \"data\": {\n                        \"status\": \"in_progress\",\n                        \"description\": f\"Dialing {sanitized_number}...\",\n                        \"done\": False,\n                    },\n                }\n            )\n\n        payload = {\n            \"to_number\": sanitized_number,\n            \"provider\": self.valves.default_voice_provider,\n            \"prompt\": prompt,\n            \"user_id\": user_id,\n            \"chat_id\": chat_id,\n        }\n\n        try:\n            print(f\"DEBUG: Sending Voice payload: {json.dumps(payload)}\")\n            response = requests.post(url, json=payload, timeout=10)\n            response.raise_for_status()\n            data = response.json()\n\n            call_id = data.get(\"call_id\")\n            if not call_id and data.get(\"status\") != \"initiated\":\n                raise Exception(\n                    f\"Gateway returned unexpected response: {json.dumps(data)}\"\n                )\n\n            if not call_id:\n                call_id = \"Confirmed\"\n\n            if __event_emitter__:\n                await __event_emitter__(\n                    {\n                        \"type\": \"message\",\n                        \"data\": {\n                            \"content\": f\"\\n\\n> 📞 **Voice Call Initiated**\\n> **To:** {sanitized_number}\\n> **ID:** `{call_id}`\\n\"\n                        },\n                    }\n                )\n                await __event_emitter__(\n                    {\n                        \"type\": \"status\",\n                        \"data\": {\n                            \"status\": \"complete\",\n                            \"description\": \"Call Ringing\",\n                            \"done\": True,\n                        },\n                    }\n                )\n            return json.dumps(data)\n\n        except Exception as e:\n            if __event_emitter__:\n                await __event_emitter__(\n                    {\n                        \"type\": \"status\",\n                        \"data\": {\n                            \"status\": \"error\",\n                            \"description\": \"Failed\",\n                            \"done\": True,\n                        },\n                    }\n                )\n            return f\"Error: {str(e)}\"\n\n    async def get_call_status(\n        self,\n        call_id: str,\n        __user__: dict = {},\n        __event_emitter__: Callable[[dict], Awaitable[None]] = None,\n    ) -> str:\n        \"\"\"\n        Retrieves the status of a specific call by ID.\n        \"\"\"\n        user_id = __user__.get(\"id\", \"unknown\")\n        url = f\"{self.valves.gateway_url.rstrip('/')}/api/calls/{call_id}\"\n\n        if __event_emitter__:\n            await __event_emitter__(\n                {\n                    \"type\": \"status\",\n                    \"data\": {\n                        \"status\": \"in_progress\",\n                        \"description\": f\"Checking Call {call_id}...\",\n                        \"done\": False,\n                    },\n                }\n            )\n\n        try:\n            response = requests.get(url, params={\"user_id\": user_id}, timeout=5)\n            response.raise_for_status()\n            data = response.json()\n\n            content = f\"\\n### 📞 Call Status: {call_id}\\n\"\n            content += f\"\\n**Status:** {data.get('status', 'Unknown')}\"\n            if data.get(\"cost\"):\n                content += f\"\\n**Cost:** ${data.get('cost')}\"\n            if data.get(\"duration\"):\n                content += f\"\\n**Duration:** {data.get('duration')}s\"\n\n            if __event_emitter__:\n                await __event_emitter__(\n                    {\n                        \"type\": \"message\",\n                        \"data\": {\"content\": content},\n                    }\n                )\n                await __event_emitter__(\n                    {\n                        \"type\": \"status\",\n                        \"data\": {\n                            \"status\": \"complete\",\n                            \"description\": \"Done\",\n                            \"done\": True,\n                        },\n                    }\n                )\n\n            return json.dumps(data, indent=2)\n\n        except Exception as e:\n            if __event_emitter__:\n                await __event_emitter__(\n                    {\n                        \"type\": \"status\",\n                        \"data\": {\n                            \"status\": \"error\",\n                            \"description\": \"Failed\",\n                            \"done\": True,\n                        },\n                    }\n                )\n            return f\"Error checking call status: {str(e)}\"\n\n    async def get_sms_status(\n        self,\n        message_id: str,\n        __user__: dict = {},\n        __event_emitter__: Callable[[dict], Awaitable[None]] = None,\n    ) -> str:\n        \"\"\"\n        Retrieves the status of a specific SMS message by ID.\n        \"\"\"\n        user_id = __user__.get(\"id\", \"unknown\")\n        url = f\"{self.valves.gateway_url.rstrip('/')}/api/messages/{message_id}\"\n\n        if __event_emitter__:\n            await __event_emitter__(\n                {\n                    \"type\": \"status\",\n                    \"data\": {\n                        \"status\": \"in_progress\",\n                        \"description\": f\"Checking SMS {message_id}...\",\n                        \"done\": False,\n                    },\n                }\n            )\n\n        try:\n            response = requests.get(url, params={\"user_id\": user_id}, timeout=5)\n            response.raise_for_status()\n            data = response.json()\n\n            content = f\"\\n### 📟 SMS Status: {message_id}\\n\"\n            content += f\"\\n**Status:** {data.get('status', 'Unknown')}\"\n            if data.get(\"cost\"):\n                content += f\"\\n**Cost:** ${data.get('cost')}\"\n            if data.get(\"error\"):\n                content += f\"\\n**Error:** {data.get('error')}\"\n\n            if __event_emitter__:\n                await __event_emitter__(\n                    {\n                        \"type\": \"message\",\n                        \"data\": {\"content\": content},\n                    }\n                )\n                await __event_emitter__(\n                    {\n                        \"type\": \"status\",\n                        \"data\": {\n                            \"status\": \"complete\",\n                            \"description\": \"Done\",\n                            \"done\": True,\n                        },\n                    }\n                )\n\n            return json.dumps(data, indent=2)\n\n        except Exception as e:\n            if __event_emitter__:\n                await __event_emitter__(\n                    {\n                        \"type\": \"status\",\n                        \"data\": {\n                            \"status\": \"error\",\n                            \"description\": \"Failed\",\n                            \"done\": True,\n                        },\n                    }\n                )\n            return f\"Error checking SMS status: {str(e)}\"\n\n    async def get_user_call_logs(\n        self,\n        limit: int = 20,\n        skip: int = 0,\n        __user__: dict = {},\n        __event_emitter__: Callable[[dict], Awaitable[None]] = None,\n    ) -> str:\n        \"\"\"\n        Retrieves a history/logs of voice calls made by or to the current user.\n        \"\"\"\n        user_id = __user__.get(\"id\", \"unknown\")\n        url = f\"{self.valves.gateway_url.rstrip('/')}/api/logs/calls\"\n\n        if __event_emitter__:\n            await __event_emitter__(\n                {\n                    \"type\": \"status\",\n                    \"data\": {\n                        \"status\": \"in_progress\",\n                        \"description\": \"Fetching call logs...\",\n                        \"done\": False,\n                    },\n                }\n            )\n\n        try:\n            # Param: user_id is required\n            response = requests.get(\n                url,\n                params={\"user_id\": user_id, \"limit\": limit, \"skip\": skip},\n                timeout=10,\n            )\n            response.raise_for_status()\n            data = response.json()\n\n            # Extract logs list from the specific response format\n            logs = data.get(\"logs\", [])\n            total_count = data.get(\"total\", 0)\n\n            # Simple cleanup for list display\n            cleaned_data = []\n            if isinstance(logs, list):\n                for entry in logs:\n                    simple_entry = {}\n                    for k, v in entry.items():\n                        # Filter out complex objects/nulls to keep table clean, optionally keep None as \"None\"\n                        if v is not None and isinstance(v, (str, int, float, bool)):\n                            simple_entry[k] = v\n                        elif v is None:\n                            simple_entry[k] = \"\"\n                    cleaned_data.append(simple_entry)\n\n            if len(cleaned_data) > 0:\n                table_md = self._format_dict_to_markdown_table(cleaned_data)\n                content = f\"\\n### 📞 Call History (Total: {total_count})\\n\\n{table_md}\"\n            else:\n                content = \"\\n> ℹ️ **No call history found.**\"\n\n            if __event_emitter__:\n                await __event_emitter__(\n                    {\n                        \"type\": \"message\",\n                        \"data\": {\"content\": content},\n                    }\n                )\n                await __event_emitter__(\n                    {\n                        \"type\": \"status\",\n                        \"data\": {\n                            \"status\": \"complete\",\n                            \"description\": \"Done\",\n                            \"done\": True,\n                        },\n                    }\n                )\n\n            return json.dumps(data, indent=2)\n\n        except Exception as e:\n            if __event_emitter__:\n                await __event_emitter__(\n                    {\n                        \"type\": \"status\",\n                        \"data\": {\n                            \"status\": \"error\",\n                            \"description\": \"Failed\",\n                            \"done\": True,\n                        },\n                    }\n                )\n            return f\"Error fetching call logs: {str(e)}\"\n\n    async def get_recent_logs(\n        self,\n        limit: int = 10,\n        __user__: dict = {},\n        __event_emitter__: Callable[[dict], Awaitable[None]] = None,\n    ) -> str:\n        \"\"\"\n        Retrieves recent general system logs.\n        \"\"\"\n        url = f\"{self.valves.gateway_url.rstrip('/')}/api/logs\"\n\n        if __event_emitter__:\n            await __event_emitter__(\n                {\n                    \"type\": \"status\",\n                    \"data\": {\n                        \"status\": \"in_progress\",\n                        \"description\": \"Fetching logs...\",\n                        \"done\": False,\n                    },\n                }\n            )\n\n        try:\n            response = requests.get(url, params={\"limit\": limit, \"skip\": 0}, timeout=5)\n            response.raise_for_status()\n            data = response.json()\n\n            # Simple cleanup for list display\n            cleaned_data = []\n            if isinstance(data, list):\n                for entry in data:\n                    simple_entry = {}\n                    for k, v in entry.items():\n                        if isinstance(v, (str, int, float, bool)):\n                            simple_entry[k] = v\n                    cleaned_data.append(simple_entry)\n\n            if len(cleaned_data) > 0:\n                table_md = self._format_dict_to_markdown_table(cleaned_data)\n                content = f\"\\n### 📜 Recent Logs\\n\\n{table_md}\"\n            else:\n                content = \"\\n> ℹ️ **No recent logs found.**\"\n\n            if __event_emitter__:\n                await __event_emitter__(\n                    {\n                        \"type\": \"message\",\n                        \"data\": {\"content\": content},\n                    }\n                )\n                await __event_emitter__(\n                    {\n                        \"type\": \"status\",\n                        \"data\": {\n                            \"status\": \"complete\",\n                            \"description\": \"Done\",\n                            \"done\": True,\n                        },\n                    }\n                )\n\n            return json.dumps(cleaned_data, indent=2)\n\n        except Exception as e:\n            if __event_emitter__:\n                await __event_emitter__(\n                    {\n                        \"type\": \"status\",\n                        \"data\": {\n                            \"status\": \"error\",\n                            \"description\": \"Failed\",\n                            \"done\": True,\n                        },\n                    }\n                )\n            return f\"Error fetching logs: {str(e)}\"\n","specs":[{"name":"get_call_status","description":"Retrieves the status of a specific call by ID.","parameters":{"properties":{"call_id":{"type":"string"}},"required":["call_id"],"type":"object"}},{"name":"get_recent_logs","description":"Retrieves recent general system logs.","parameters":{"properties":{"limit":{"default":10,"type":"integer"}},"type":"object"}},{"name":"get_sms_status","description":"Retrieves the status of a specific SMS message by ID.","parameters":{"properties":{"message_id":{"type":"string"}},"required":["message_id"],"type":"object"}},{"name":"get_user_call_logs","description":"Retrieves a history/logs of voice calls made by or to the current user.","parameters":{"properties":{"limit":{"default":20,"type":"integer"},"skip":{"default":0,"type":"integer"}},"type":"object"}},{"name":"initiate_voice_call","description":"Initiates an outbound voice call/TTS alert.","parameters":{"properties":{"to_number":{"type":"string"},"prompt":{"type":"string"}},"required":["to_number","prompt"],"type":"object"}},{"name":"send_sms","description":"Sends an SMS text message.","parameters":{"properties":{"to_number":{"type":"string"},"message":{"type":"string"}},"required":["to_number","message"],"type":"object"}}]}]