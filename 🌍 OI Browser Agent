[{"id":"oi_browser_agent","user_id":"713408df-bb82-4297-99af-3be743f48992","name":"OI Browser Agent","meta":{"description":"Vision-based browser agent — screenshots for navigation (like Claude for Chrome). One action per call with think-act-observe loop","manifest":{"title":"Open WebUI Browser Agent","author":"Open WebUI Community","version":"2.4.1","description":"Vision-based browser agent — screenshots for navigation (like Claude for Chrome). One action per call with think-act-observe loop.","required_open_webui_version":"0.5.0"},"has_user_valves":false},"access_grants":[],"updated_at":1784933027,"created_at":1784933027,"user":null,"write_access":true,"content":"\"\"\"\ntitle: Open WebUI Browser Agent\nauthor: Open WebUI Community\nversion: 2.4.1\ndescription: Vision-based browser agent — screenshots for navigation (like Claude for Chrome). One action per call with think-act-observe loop.\nrequired_open_webui_version: 0.5.0\n\"\"\"\n\nimport asyncio\nimport base64\nimport json\nfrom typing import Optional, Union\n\nfrom pydantic import BaseModel, Field\n\ntry:\n    from open_webui.routers.images import upload_image\n    from open_webui.models.users import Users\n\n    _OWUI_INTERNALS = True\nexcept ImportError:\n    _OWUI_INTERNALS = False\n\n\nclass Tools:\n    SCREENSHOT_CHAIN_AFTER = {\n        \"takeover\",\n        \"use_current_page\",\n        \"click_at\",\n        \"click_quiz_answer\",\n        \"click_quiz_next\",\n        \"solve_quiz_step\",\n        \"click\",\n        \"scroll\",\n        \"dismiss_popups\",\n        \"type\",\n        \"type_and_submit\",\n        \"press_key\",\n        \"navigate\",\n        \"reload\",\n        \"wait\",\n    }\n\n    class Valves(BaseModel):\n        navigation_mode: str = Field(\n            default=\"screenshot\",\n            description=\"screenshot = vision navigation (default, like Claude for Chrome). text = page_text mode.\",\n        )\n        confirm_navigation: bool = Field(\n            default=False,\n            description=\"Ask the user to confirm before navigating to a new URL.\",\n        )\n        auto_include_page_text: bool = Field(\n            default=False,\n            description=\"Include page_text after each step (only used when navigation_mode=text).\",\n        )\n        auto_paste_screenshot: bool = Field(\n            default=True,\n            description=\"Also paste screenshots into chat (recommended — vision fallback when execute payload is trimmed).\",\n        )\n        max_text_chars: int = Field(\n            default=16000,\n            description=\"Truncate page text in tool responses to this length (text mode only).\",\n        )\n\n    def __init__(self):\n        self.valves = self.Valves()\n        self._browser_step = 0\n\n    def _uses_screenshot_nav(self) -> bool:\n        return (\n            self.valves.navigation_mode or \"screenshot\"\n        ).strip().lower() == \"screenshot\"\n\n    def _is_solve_quiz_goal(self, goal: str) -> bool:\n        g = (goal or \"\").lower()\n        return any(\n            phrase in g\n            for phrase in (\n                \"solve\",\n                \"answer\",\n                \"complete\",\n                \"finish\",\n                \"solve all\",\n                \"solve them\",\n            )\n        )\n\n    def _exec_timeout(self, action: str) -> float:\n        medium = {\n            \"click_at\",\n            \"click\",\n            \"scroll\",\n            \"wait\",\n            \"dismiss_popups\",\n            \"press_key\",\n            \"type\",\n            \"type_and_submit\",\n            \"select\",\n            \"go_back\",\n            \"go_forward\",\n            \"click_quiz_answer\",\n            \"click_quiz_next\",\n            \"solve_quiz_step\",\n        }\n        slow = {\"navigate\", \"search\", \"open_tab\", \"reload\"}\n        if action in {\"ping\"}:\n            return 8.0\n        if action in {\"takeover\", \"use_current_page\"}:\n            return 22.0\n        if action in {\"screenshot\", \"get_active_tab\"}:\n            return 18.0\n        if action in medium:\n            return 30.0\n        if action in slow:\n            return 45.0\n        return 30.0\n\n    def _error_recovery(\n        self,\n        action: str,\n        step: int,\n        exc: Exception,\n        thought: str = \"\",\n        goal: str = \"\",\n    ) -> dict:\n        msg = str(exc)\n        timed_out = \"timed out\" in msg.lower() or isinstance(exc, TimeoutError)\n        session_lost = \"session disconnected\" in msg.lower()\n        return {\n            \"error\": msg,\n            \"timed_out\": timed_out,\n            \"session_disconnected\": session_lost,\n            \"action\": action,\n            \"step\": step,\n            \"recoverable\": True,\n            \"tool_was_called\": True,\n            \"browser_agent_available\": True,\n            \"can_control_browser\": True,\n            \"recorded_thought\": thought or None,\n            \"goal\": goal or None,\n            \"never_tell_user\": (\n                \"Do NOT say you cannot take over or control the browser. \"\n                \"Do NOT say the browser agent tool is unavailable — it WAS just called. \"\n                \"Do NOT say you can only produce text in chat. \"\n                \"Do NOT ask the user to paste page text or screenshot descriptions. \"\n                \"Use browser_agent — call it again now.\"\n            ),\n            \"must_call_tool_before_reply\": True,\n            \"do_not_reply_to_user\": True,\n            \"retry_first_action\": \"ping\",\n            \"model_instruction\": (\n                \"browser_agent IS available — you just used it and got a recoverable error. \"\n                \"RETRY NOW — do not reply to the user yet. \"\n                + (\n                    \"OpenWebUI client session dropped — call browser_agent action=takeover again \"\n                    \"(screenshot auto-chains in the same call). \"\n                    if session_lost\n                    else \"Sequence: action=ping → action=takeover → action=click_at. \"\n                )\n                + \"Ask user ONLY to: (1) open Open WebUI Browser Agent side panel, (2) click the website tab, \"\n                \"(3) confirm Target Match URL in extension options matches Open WebUI. \"\n                \"NEVER ask user to paste problems or screenshots. NEVER explain a plan instead of calling the tool.\"\n            ),\n            \"connection_checklist\": [\n                \"Reload extension at chrome://extensions\",\n                \"Open WebUI Browser Agent side panel is open with Open WebUI loaded\",\n                \"Target Match URL in options matches your Open WebUI URL (with /*)\",\n                \"Click the Canvas/website tab (not the side panel) before takeover\",\n            ],\n            \"retry_actions\": [\n                \"ping\",\n                \"takeover\",\n                \"screenshot\",\n                \"dismiss_popups\",\n                \"click_at\",\n                \"scroll\",\n            ],\n            \"forbidden_responses\": [\n                \"asking user to paste page text\",\n                \"asking user to describe screenshots\",\n                \"claiming you cannot control the browser\",\n                \"claiming the browser agent tool is not available\",\n                \"claiming you can only produce text in chat\",\n            ],\n        }\n\n    def _decode_data_url(self, data_url: str) -> tuple[bytes, str]:\n        if not data_url:\n            raise ValueError(\"Empty screenshot data\")\n        mime_type = \"image/png\"\n        encoded = data_url\n        if \",\" in data_url and data_url.strip().lower().startswith(\"data:\"):\n            header, encoded = data_url.split(\",\", 1)\n            mime_type = header.split(\";\")[0].split(\":\")[-1] or \"image/png\"\n        return base64.b64decode(encoded), mime_type\n\n    async def _emit_screenshot(\n        self,\n        data_url: str,\n        meta: dict,\n        __request__=None,\n        __user__: Optional[dict] = None,\n        __event_emitter__=None,\n        __event_call__=None,\n    ) -> Optional[str]:\n        if not __event_emitter__ or not data_url:\n            return None\n\n        image_url = None\n        if _OWUI_INTERNALS and __request__ and __user__:\n            try:\n                image_data, content_type = self._decode_data_url(data_url)\n                user_model = Users.get_user_by_id(__user__[\"id\"])\n                if user_model:\n                    image_url = await asyncio.wait_for(\n                        upload_image(\n                            __request__,\n                            image_data,\n                            content_type,\n                            meta,\n                            user_model,\n                        ),\n                        timeout=15.0,\n                    )\n            except asyncio.TimeoutError:\n                meta[\"upload_error\"] = \"screenshot upload timed out after 15s\"\n            except Exception as exc:\n                meta[\"upload_error\"] = str(exc)\n\n        if image_url:\n            await __event_emitter__(\n                {\n                    \"type\": \"files\",\n                    \"data\": {\"files\": [{\"type\": \"image\", \"url\": image_url}]},\n                }\n            )\n            return image_url\n\n        if __event_call__:\n            await __event_call__(\n                {\n                    \"type\": \"execute\",\n                    \"data\": {\n                        \"code\": (\n                            \"window.parent.postMessage(\"\n                            f\"{{type:'EXECUTE_PASTE',contentType:'image',data:{json.dumps(data_url)}}}, '*');\"\n                            \"return true;\"\n                        )\n                    },\n                }\n            )\n            meta[\"screenshot_paste_fallback\"] = True\n        return None\n\n    def _build_status_label(\n        self,\n        step: int,\n        action: str,\n        params: Optional[dict] = None,\n        thought: str = \"\",\n        suffix: str = \"\",\n    ) -> str:\n        params = params or {}\n        parts = [f\"Step {step}: {action}\"]\n        if params.get(\"query\"):\n            parts.append(f'\"{str(params[\"query\"])[:50]}\"')\n        elif params.get(\"url\"):\n            parts.append(str(params[\"url\"])[:60])\n        elif action == \"solve_quiz_step\" and (\n            params.get(\"answer\") or params.get(\"text\")\n        ):\n            parts.append(\n                f'answer {str(params.get(\"answer\") or params.get(\"text\"))[:1].upper()}'\n            )\n        elif params.get(\"text\"):\n            parts.append(f'type \"{str(params[\"text\"])[:36]}\"')\n        elif action == \"click_at\" and params.get(\"x\") is not None:\n            parts.append(f\"({params.get('x')}, {params.get('y')})\")\n        elif action == \"scroll\":\n            parts.append(\n                f\"{params.get('direction', 'down')} {params.get('amount', 400)}px\"\n            )\n        if thought and not suffix:\n            parts.append(f\"— {thought[:60]}\")\n        if suffix:\n            parts.append(suffix)\n        return \" \".join(parts)\n\n    async def _emit_status(\n        self, description: str, done: bool, __event_emitter__=None\n    ) -> None:\n        if not __event_emitter__:\n            return\n        await __event_emitter__(\n            {\n                \"type\": \"status\",\n                \"data\": {\"description\": description, \"done\": done, \"hidden\": False},\n            }\n        )\n\n    def _should_chain_screenshot(self, action: str, navigation_mode: str) -> bool:\n        return (\n            navigation_mode or \"screenshot\"\n        ).strip().lower() == \"screenshot\" and action in self.SCREENSHOT_CHAIN_AFTER\n\n    def _build_execute_code(self, payload: dict, chain_screenshot: bool) -> str:\n        primary = json.dumps(payload, ensure_ascii=False)\n        missing = 'throw new Error(\"Open WebUI Browser Agent not connected — open the side panel and reload Open WebUI.\");'\n        if not chain_screenshot:\n            return (\n                f\"if (!window.__OWUI_SIDEKICK__) {{{missing}}}\"\n                f\"return await window.__OWUI_SIDEKICK__.execute({primary});\"\n            )\n\n        followup = json.dumps(\n            {\n                \"action\": \"screenshot\",\n                \"params\": {**(payload.get(\"params\") or {}), \"use_current_tab\": True},\n                \"auto_include_page_text\": False,\n                \"auto_screenshot\": False,\n                \"navigation_mode\": payload.get(\"navigation_mode\", \"screenshot\"),\n            },\n            ensure_ascii=False,\n        )\n        return (\n            f\"if (!window.__OWUI_SIDEKICK__) {{{missing}}}\"\n            f\"return await window.__OWUI_SIDEKICK__.executePipeline({primary}, {followup});\"\n        )\n\n    def _normalize_execute_result(self, result) -> dict:\n        if isinstance(result, str):\n            if \"session disconnected\" in result.lower():\n                raise RuntimeError(result)\n            try:\n                result = json.loads(result)\n            except json.JSONDecodeError:\n                return {\"raw\": result}\n        if isinstance(result, dict):\n            err = result.get(\"error\")\n            if err and \"session disconnected\" in str(err).lower():\n                raise RuntimeError(str(err))\n            return result\n        return {\"result\": result}\n\n    async def _event_call_execute(\n        self,\n        code: str,\n        exec_timeout: float,\n        __event_call__=None,\n    ):\n        last_exc = None\n        for attempt in range(3):\n            try:\n                result = await asyncio.wait_for(\n                    __event_call__({\"type\": \"execute\", \"data\": {\"code\": code}}),\n                    timeout=exec_timeout,\n                )\n                return self._normalize_execute_result(result)\n            except asyncio.TimeoutError:\n                raise\n            except Exception as exc:\n                last_exc = exc\n                if \"session disconnected\" in str(exc).lower() and attempt < 2:\n                    await asyncio.sleep(0.35 * (attempt + 1))\n                    continue\n                raise\n        if last_exc:\n            raise last_exc\n        raise RuntimeError(\"execute failed\")\n\n    async def _sidekick_execute(\n        self,\n        action: str,\n        params: Optional[dict] = None,\n        auto_include_page_text: bool = True,\n        auto_screenshot: bool = False,\n        navigation_mode: str = \"screenshot\",\n        status_label: str = \"\",\n        __event_call__=None,\n        __event_emitter__=None,\n    ) -> dict:\n        label = status_label or f\"Browser: {action}\"\n        await self._emit_status(label, False, __event_emitter__)\n\n        payload = {\n            \"action\": action,\n            \"params\": params or {},\n            \"auto_include_page_text\": auto_include_page_text,\n            \"auto_screenshot\": auto_screenshot,\n            \"navigation_mode\": navigation_mode,\n        }\n        chain_screenshot = self._should_chain_screenshot(action, navigation_mode)\n        code = self._build_execute_code(payload, chain_screenshot)\n\n        exec_timeout = self._exec_timeout(action)\n        if chain_screenshot:\n            exec_timeout = max(exec_timeout, 28.0)\n        try:\n            result = await self._event_call_execute(code, exec_timeout, __event_call__)\n        except asyncio.TimeoutError:\n            await self._emit_status(\n                f\"{label} — timed out ({int(exec_timeout)}s)\", True, __event_emitter__\n            )\n            raise TimeoutError(\n                f\"Browser command timed out after {int(exec_timeout)} seconds\"\n            )\n        except Exception as exc:\n            await self._emit_status(f\"{label} — failed: {exc}\", True, __event_emitter__)\n            raise\n\n        await self._emit_status(f\"{label} ✓\", True, __event_emitter__)\n        return result\n\n    def _screenshot_nav_hints(self, payload: dict) -> dict:\n        has_screenshot = bool(\n            payload.get(\"screenshot_attached\")\n            or payload.get(\"screenshot_emitted\")\n            or payload.get(\"screenshot_delivered_via\") == \"paste\"\n            or payload.get(\"screenshot_paste_fallback\")\n        )\n        takeover_done = bool(\n            payload.get(\"takeover_complete\")\n            or payload.get(\"took_over\")\n            or payload.get(\"skipped_takeover\")\n            or payload.get(\"already_controlled\")\n        )\n        needs_screenshot = bool(\n            payload.get(\"screenshot_missing\")\n            or payload.get(\"screenshot_deferred\")\n            or payload.get(\"next_required_action\") == \"screenshot\"\n            or (takeover_done and not has_screenshot)\n        )\n        return {\n            \"has_screenshot\": has_screenshot,\n            \"takeover_done\": takeover_done,\n            \"needs_screenshot\": needs_screenshot,\n        }\n\n    def _apply_screenshot_nav_instructions(self, payload: dict) -> None:\n        hints = self._screenshot_nav_hints(payload)\n        payload[\"navigation_mode\"] = \"screenshot\"\n        payload[\"requires_vision_model\"] = True\n        payload[\"can_control_browser\"] = True\n        payload[\"forbidden_responses\"] = [\n            \"asking user to paste page text\",\n            \"asking user to share or describe screenshots\",\n            \"claiming you cannot control the browser\",\n            \"claiming you can only produce text in chat\",\n            \"claiming the browser session is disconnected\",\n            \"explaining a plan instead of calling browser_agent\",\n            \"calling action=screenshot after takeover\",\n        ]\n\n        if hints[\"takeover_done\"]:\n            payload[\"takeover_complete\"] = True\n            forbidden = [\"takeover\", \"use_current_page\", \"screenshot\"]\n            payload[\"forbidden_actions\"] = forbidden\n\n        if hints[\"has_screenshot\"]:\n            payload[\"do_not_reply_to_user\"] = True\n            payload[\"must_call_tool_before_reply\"] = True\n            payload[\"next_required_action\"] = \"click_at\"\n            payload[\"model_instruction\"] = (\n                \"Screenshot is attached — you CAN see the page. \"\n                \"Call browser_agent NOW with action=dismiss_popups or action=click_at (normalized x,y). \"\n                \"DO NOT reply to the user. DO NOT ask the user to paste anything.\"\n            )\n        elif hints[\"needs_screenshot\"]:\n            payload[\"do_not_reply_to_user\"] = True\n            payload[\"must_call_tool_before_reply\"] = True\n            payload[\"next_required_action\"] = \"takeover\"\n            payload[\"forbidden_actions\"] = payload.get(\"forbidden_actions\") or []\n            if \"screenshot\" not in payload[\"forbidden_actions\"]:\n                payload[\"forbidden_actions\"] = [\n                    *payload[\"forbidden_actions\"],\n                    \"screenshot\",\n                ]\n            payload[\"model_instruction\"] = (\n                \"Screenshot missing — do NOT call action=screenshot (session disconnect). \"\n                \"Call browser_agent action=takeover again (screenshot auto-chains in same call), \"\n                \"or action=click_at if page_snapshot.text is present. Never ask the user to paste.\"\n            )\n        elif not payload.get(\"model_instruction\"):\n            payload[\"model_instruction\"] = (\n                \"Study the screenshot attached to this result. THINK, then call browser_agent with \"\n                \"thought=... and ONE action. Use click_at (x,y) with coordinate_system=normalized \"\n                \"(0.0–1.0). Do NOT answer until agent_loop.task_done is true.\"\n            )\n\n        if payload.get(\"page_snapshot\"):\n            snap = payload[\"page_snapshot\"]\n            if isinstance(snap, dict) and snap.get(\"text\"):\n                payload[\"page_snapshot_hint\"] = (\n                    \"page_snapshot.text is a text fallback if vision is unavailable — \"\n                    \"still prefer screenshot + click_at; never ask the user to paste.\"\n                )\n\n    def _apply_quiz_solve_instructions(self, payload: dict, goal: str = \"\") -> None:\n        quiz = bool(\n            payload.get(\"quiz_mode\")\n            or payload.get(\"solve_on_page_required\")\n            or payload.get(\"page_type\") == \"quiz_page\"\n            or self._is_solve_quiz_goal(goal)\n            or self._is_solve_quiz_goal(payload.get(\"goal\") or \"\")\n        )\n        if not quiz:\n            return\n\n        payload[\"quiz_mode\"] = True\n        payload[\"solve_on_page_required\"] = True\n        payload[\"task_done\"] = payload.get(\"quiz_submitted\", False)\n        payload[\"do_not_reply_to_user\"] = not payload.get(\"quiz_submitted\")\n        payload[\"must_call_tool_before_reply\"] = not payload.get(\"quiz_submitted\")\n        payload[\"next_required_action\"] = \"click_at\"\n        payload[\"forbidden_responses\"] = [\n            *(payload.get(\"forbidden_responses\") or []),\n            \"listing quiz answers in chat without clicking\",\n            \"summarizing quiz solutions instead of click_at\",\n            \"giving quiz answers before clicking on the webpage\",\n        ]\n\n        opts = payload.get(\"quiz_options\") or []\n        opt_hint = \"\"\n        if opts:\n            first = opts[0]\n            opt_hint = (\n                f\" First visible option: click_at x={first.get('x')}, y={first.get('y')} \"\n                f\"({str(first.get('text', ''))[:40]}).\"\n            )\n\n        if payload.get(\"quiz_submitted\"):\n            payload[\"model_instruction\"] = (\n                \"Quiz submitted on the webpage. Summarize the outcome for the user.\"\n            )\n        else:\n            payload[\"model_instruction\"] = (\n                \"QUIZ SOLVE MODE — Writing answers in chat is FORBIDDEN. \"\n                \"Prefer solve_quiz_step with answer='A'-'F' (one call: select + Next). \"\n                \"Fallback: click_quiz_answer then click_quiz_next, or click_at with x,y in 0.0–1.0 only.\"\n                + opt_hint\n                + \" Repeat until quiz_submitted.\"\n            )\n\n    def _finalize_payload(\n        self, payload: dict, thought: str = \"\", goal: str = \"\"\n    ) -> dict:\n        screenshot_nav = self._uses_screenshot_nav()\n        limit = max(2000, int(self.valves.max_text_chars))\n\n        payload.pop(\"screenshot\", None)\n\n        if screenshot_nav:\n            for key in (\n                \"page_text\",\n                \"text\",\n                \"html\",\n                \"products\",\n                \"product_lines\",\n                \"links\",\n                \"clickable_elements\",\n                \"search_box_indexes\",\n                \"elements\",\n            ):\n                payload.pop(key, None)\n            self._apply_screenshot_nav_instructions(payload)\n            self._apply_quiz_solve_instructions(payload, goal=goal)\n        else:\n            for key in (\"page_text\", \"text\", \"html\"):\n                if (\n                    key in payload\n                    and isinstance(payload[key], str)\n                    and len(payload[key]) > limit\n                ):\n                    payload[key] = payload[key][:limit]\n                    payload[f\"{key}_truncated\"] = True\n\n            if payload.get(\"text\") and not payload.get(\"page_text\"):\n                payload[\"page_text\"] = payload[\"text\"]\n\n        if thought:\n            payload[\"recorded_thought\"] = thought\n        if goal:\n            payload[\"goal\"] = goal\n\n        if not screenshot_nav:\n            payload[\"can_control_browser\"] = True\n\n        loop = payload.get(\"agent_loop\") or {}\n        page_state = payload.get(\"page_state\") or {}\n\n        if not screenshot_nav:\n            if page_state.get(\"likely_login_page\"):\n                payload[\"login_required\"] = True\n                payload[\"model_instruction\"] = (\n                    \"Login page detected. Ask the user to sign in, then continue the loop with get_page_text.\"\n                )\n            elif loop.get(\"task_done\"):\n                payload[\"model_instruction\"] = (\n                    \"Task complete. Summarize for the user using page_text and product details from this result.\"\n                )\n            elif payload.get(\"took_over\"):\n                payload[\"model_instruction\"] = (\n                    \"You took over the user's current tab. Read page_text and products. \"\n                    \"THINK, then call browser_agent with the next action on THIS tab. \"\n                    \"Do not navigate away unless the user asks.\"\n                )\n            elif payload.get(\"products\"):\n                payload[\"model_instruction\"] = (\n                    \"THINK in your reasoning about the products. Then call browser_agent AGAIN with \"\n                    \"thought=... and ONE action. To open a listing: action=click_product, product_index=N \"\n                    \"(use products[].index). Do NOT reply to the user until agent_loop.task_done is true.\"\n                )\n            elif payload.get(\"page_text\"):\n                payload[\"model_instruction\"] = (\n                    \"THINK in your reasoning about what you observed. Then call browser_agent AGAIN with \"\n                    \"thought=... and ONE next action. Read agent_loop and suggested_actions. \"\n                    \"Do NOT reply to the user until the goal is complete.\"\n                )\n\n        return payload\n\n    async def browser_agent(\n        self,\n        thought: str = \"\",\n        action: str = \"\",\n        goal: str = \"\",\n        use_current_tab: bool = False,\n        url: str = \"\",\n        query: str = \"\",\n        text: str = \"\",\n        selector: str = \"\",\n        index: int = -1,\n        product_index: int = 0,\n        x: float = -1,\n        y: float = -1,\n        coordinate_system: str = \"normalized\",\n        direction: str = \"down\",\n        amount: int = 400,\n        key: str = \"Enter\",\n        tab_id: int = 0,\n        wait_ms: int = 2500,\n        clear: bool = False,\n        engine: str = \"google\",\n        value: str = \"\",\n        target: str = \"auto\",\n        __event_call__=None,\n        __event_emitter__=None,\n        __request__=None,\n        __user__: Optional[dict] = None,\n    ) -> str:\n        \"\"\"\n        YOU CONTROL the user's Chrome browser. You HAVE screenshot and click tools — use them.\n        NEVER say you \"can only produce text\" or cannot execute browser tools — that is FALSE.\n        NEVER ask the user to paste screenshots, questions, or page content.\n\n        Vision browser agent — ONE action per call. Uses screenshots for navigation (default).\n\n        REQUIRES a vision-capable model. After each step a screenshot is attached for you to study.\n\n        On timeout/error: read model_instruction and call browser_agent again (ping → takeover → act).\n\n        LOOP (required):\n        1. THINK about the goal and the screenshot from the last step\n        2. Call browser_agent with thought=\"...\" and ONE action\n        3. Study the new screenshot in the tool result\n        4. Repeat until agent_loop.task_done is true\n        5. Only then answer the user\n\n        QUIZ / \"solve\" goals: NEVER list answers in chat. Click each answer on the webpage with\n        click_at using quiz_options coordinates, then click Next/Submit. task_done only when\n        quiz_submitted is true.\n\n        START: action=takeover ONCE (user clicks website tab first). Screenshot auto-chains in the\n        SAME tool call — do NOT call action=screenshot separately (causes session disconnect).\n        After takeover, use click_at, dismiss_popups, scroll. NEVER call takeover again.\n        When must_call_tool_before_reply or do_not_reply_to_user is true, your ONLY valid move is\n        another browser_agent call — explaining the plan to the user is forbidden.\n\n        Quiz clicks (preferred on WWF/quiz pages):\n        - action=solve_quiz_step, text=\"A\"  — BEST: select answer + click Next in one call\n        - action=click_quiz_answer, text=\"A\"  — current question ONLY (then click_quiz_next)\n        - quiz_options has distinct x,y per option — do NOT use 0.5,0.5 for all\n        - NEVER use y>1.0 with normalized coords — values must be 0.0–1.0\n\n        Vision clicks:\n        - action=click_at, x=0.42, y=0.18, coordinate_system=normalized\n        - x,y are 0.0–1.0 fractions of the viewport (or use selector=...)\n\n        Other actions: search, navigate, type, type_and_submit, scroll, wait, dismiss_popups\n\n        Scroll: many sites (WWF, Canvas) use inner scroll containers — scroll reports scroll_targets\n        and scroll_containers. If window_delta is tiny, use click_at on visible options or press_key PageDown/Tab.\n\n        Text mode: set tool valve navigation_mode=text to use page_text instead of screenshots.\n\n        :param thought: Your reasoning BEFORE this action (required for multi-step tasks)\n        :param goal: Overall user goal (repeat each call until done)\n        :param action: Single browser action to run\n        :param x: For click_at — horizontal position (see coordinate_system)\n        :param y: For click_at — vertical position (see coordinate_system)\n        :param coordinate_system: normalized (0–1), permille (0–1000), or pixel\n        \"\"\"\n\n        action = (action or \"\").strip().lower().replace(\" \", \"_\")\n        if not action:\n            raise ValueError(\"action is required\")\n\n        screenshot_nav = self._uses_screenshot_nav()\n        step = self._browser_step + 1\n\n        try:\n            return await self._browser_agent_run(\n                action=action,\n                thought=thought,\n                goal=goal,\n                screenshot_nav=screenshot_nav,\n                use_current_tab=use_current_tab,\n                url=url,\n                query=query,\n                text=text,\n                selector=selector,\n                index=index,\n                product_index=product_index,\n                x=x,\n                y=y,\n                coordinate_system=coordinate_system,\n                direction=direction,\n                amount=amount,\n                key=key,\n                tab_id=tab_id,\n                wait_ms=wait_ms,\n                clear=clear,\n                engine=engine,\n                value=value,\n                target=target,\n                __event_call__=__event_call__,\n                __event_emitter__=__event_emitter__,\n                __request__=__request__,\n                __user__=__user__,\n            )\n        except Exception as exc:\n            recovery = self._error_recovery(\n                action, step, exc, thought=thought, goal=goal\n            )\n            await self._emit_status(\n                f\"Step {step}: {action} — recoverable error\", True, __event_emitter__\n            )\n            return json.dumps(recovery, ensure_ascii=False)\n\n    async def _browser_agent_run(\n        self,\n        action: str,\n        thought: str,\n        goal: str,\n        screenshot_nav: bool,\n        use_current_tab: bool,\n        url: str,\n        query: str,\n        text: str,\n        selector: str,\n        index: int,\n        product_index: int,\n        x: float,\n        y: float,\n        coordinate_system: str,\n        direction: str,\n        amount: int,\n        key: str,\n        tab_id: int,\n        wait_ms: int,\n        clear: bool,\n        engine: str,\n        value: str,\n        target: str,\n        __event_call__=None,\n        __event_emitter__=None,\n        __request__=None,\n        __user__: Optional[dict] = None,\n    ) -> str:\n        if action == \"navigate\" and self.valves.confirm_navigation and __event_call__:\n            approved = await __event_call__(\n                {\n                    \"type\": \"confirmation\",\n                    \"data\": {\n                        \"title\": \"Navigate browser?\",\n                        \"message\": f\"Open {url or '(no url)'}?\",\n                    },\n                }\n            )\n            if not approved:\n                return json.dumps({\"cancelled\": True, \"action\": action})\n\n        params: dict[str, Union[str, int, bool, float]] = {}\n        if thought:\n            params[\"thought\"] = thought\n        if goal:\n            params[\"goal\"] = goal\n        if use_current_tab:\n            params[\"use_current_tab\"] = True\n        if tab_id > 0:\n            params[\"tab_id\"] = int(tab_id)\n\n        if action in {\"navigate\", \"reload\", \"search\", \"open_tab\", \"wait\"}:\n            params[\"wait_ms\"] = min(max(int(wait_ms), 0), 10000)\n        if action == \"search\":\n            if not query:\n                raise ValueError(\"query is required for search\")\n            params[\"query\"] = query\n            params[\"engine\"] = engine or \"google\"\n        if action in {\"navigate\", \"open_tab\"}:\n            if not url:\n                raise ValueError(\"url is required\")\n            params[\"url\"] = url\n        if action == \"switch_tab\":\n            if tab_id <= 0:\n                raise ValueError(\"tab_id is required for switch_tab\")\n            params[\"tab_id\"] = tab_id\n        if action == \"click_product\":\n            if product_index <= 0:\n                raise ValueError(\n                    \"product_index is required for click_product (1-based, from products list)\"\n                )\n            params[\"product_index\"] = int(product_index)\n        if action in {\"click_quiz_answer\", \"solve_quiz_step\"}:\n            answer = (text or \"\").strip()\n            if not answer:\n                raise ValueError(\n                    f\"{action} requires text/answer='A'-'F' (or option_index)\"\n                )\n            params[\"answer\"] = answer\n            if index > 0:\n                params[\"option_index\"] = int(index)\n        if action == \"click_at\":\n            if selector:\n                params[\"selector\"] = selector\n            elif x < 0 or y < 0:\n                raise ValueError(\n                    \"click_at requires x and y coordinates (0.0–1.0 normalized) or selector\"\n                )\n            else:\n                fx, fy = float(x), float(y)\n                cs = (coordinate_system or \"normalized\").strip().lower()\n                if cs in {\"normalized\", \"norm\"} and (fx > 1.05 or fy > 1.05):\n                    if fx <= 1000 and fy <= 1000:\n                        cs = \"permille\"\n                    else:\n                        fx = max(0.02, min(0.98, fx))\n                        fy = max(0.02, min(0.98, fy))\n                        params[\"coords_clamped\"] = True\n                params[\"x\"] = fx\n                params[\"y\"] = fy\n                params[\"coordinate_system\"] = cs\n        if action == \"click\":\n            if index >= 0:\n                params[\"index\"] = index\n            if selector:\n                params[\"selector\"] = selector\n            if \"index\" not in params and \"selector\" not in params:\n                raise ValueError(\n                    \"click requires selector or index (prefer click_at in screenshot mode)\"\n                )\n        if action in {\"type\", \"type_and_submit\"}:\n            if not text:\n                raise ValueError(\"text is required for type\")\n            params[\"text\"] = text\n            params[\"clear\"] = clear\n            if index >= 0:\n                params[\"index\"] = index\n            if selector:\n                params[\"selector\"] = selector\n            if target:\n                params[\"target\"] = target\n            if not selector and index < 0:\n                params[\"prefer_search\"] = True\n        if action == \"type_and_submit\":\n            params[\"key\"] = key or \"Enter\"\n        if action == \"select\":\n            if index >= 0:\n                params[\"index\"] = index\n            if selector:\n                params[\"selector\"] = selector\n            params[\"value\"] = value\n        if action == \"scroll\":\n            params[\"direction\"] = direction or \"down\"\n            params[\"amount\"] = int(amount)\n            if selector:\n                params[\"selector\"] = selector\n        if action == \"press_key\":\n            params[\"key\"] = key or \"Enter\"\n            if selector:\n                params[\"selector\"] = selector\n        if action == \"wait\":\n            params[\"ms\"] = min(max(int(wait_ms), 0), 10000)\n\n        allowed = {\n            \"ping\",\n            \"search\",\n            \"open_tab\",\n            \"get_active_tab\",\n            \"list_tabs\",\n            \"switch_tab\",\n            \"navigate\",\n            \"reload\",\n            \"go_back\",\n            \"go_forward\",\n            \"screenshot\",\n            \"get_page_text\",\n            \"get_page_html\",\n            \"get_interactive_elements\",\n            \"get_quiz_options\",\n            \"dismiss_popups\",\n            \"takeover\",\n            \"use_current_page\",\n            \"click\",\n            \"click_at\",\n            \"click_quiz_answer\",\n            \"click_quiz_next\",\n            \"solve_quiz_step\",\n            \"click_product\",\n            \"type\",\n            \"type_and_submit\",\n            \"select\",\n            \"scroll\",\n            \"press_key\",\n            \"wait\",\n        }\n        if action not in allowed:\n            raise ValueError(f\"Unknown action '{action}'\")\n\n        self._browser_step += 1\n        step = self._browser_step\n        status_label = self._build_status_label(step, action, params, thought)\n\n        nav_mode = \"screenshot\" if screenshot_nav else \"text\"\n        include_text = not screenshot_nav and self.valves.auto_include_page_text\n        paste_shot = self.valves.auto_paste_screenshot or screenshot_nav\n\n        result = await self._sidekick_execute(\n            action,\n            params,\n            auto_include_page_text=include_text,\n            auto_screenshot=paste_shot,\n            navigation_mode=nav_mode,\n            status_label=status_label,\n            __event_call__=__event_call__,\n            __event_emitter__=__event_emitter__,\n        )\n\n        screenshot_data = result.pop(\"screenshot\", None)\n        if screenshot_nav and result.get(\"screenshot_delivered_via\") == \"paste\":\n            result[\"screenshot_emitted\"] = True\n            result[\"screenshot_attached\"] = True\n            result[\"screenshot_paste_fallback\"] = True\n            result[\"do_not_reply_to_user\"] = True\n            result[\"must_call_tool_before_reply\"] = True\n            result[\"next_required_action\"] = \"click_at\"\n        if screenshot_nav and screenshot_data and not result.get(\"screenshot_deferred\"):\n            shot_meta = {\n                \"source\": \"oi_browser_agent\",\n                \"action\": action,\n                \"step\": step,\n                \"url\": result.get(\"page_url\") or result.get(\"url\"),\n                \"title\": result.get(\"page_title\") or result.get(\"title\"),\n            }\n            try:\n                image_url = await asyncio.wait_for(\n                    self._emit_screenshot(\n                        screenshot_data,\n                        shot_meta,\n                        __request__=__request__,\n                        __user__=__user__,\n                        __event_emitter__=__event_emitter__,\n                        __event_call__=__event_call__,\n                    ),\n                    timeout=8.0,\n                )\n            except asyncio.TimeoutError:\n                image_url = None\n                result[\"screenshot_upload_timeout\"] = True\n            if image_url:\n                result[\"screenshot_url\"] = image_url\n            result[\"screenshot_emitted\"] = bool(image_url)\n            page_url = result.get(\"page_url\") or result.get(\"url\") or \"\"\n            await self._emit_status(\n                f\"Step {step} done — {page_url[:70] or 'ready'}\",\n                True,\n                __event_emitter__,\n            )\n        elif screenshot_nav and not screenshot_data:\n            result[\"screenshot_missing\"] = True\n\n        if goal and self._is_solve_quiz_goal(goal):\n            result[\"goal\"] = goal\n            result[\"solve_on_page_required\"] = True\n\n        result = self._finalize_payload(result, thought=thought, goal=goal)\n        result[\"step\"] = step\n        result[\"step_summary\"] = status_label\n        result[\"action\"] = action\n        if goal:\n            result[\"goal\"] = goal\n        return json.dumps(result, ensure_ascii=False)\n\n    async def browser_agent_run_steps(\n        self,\n        steps_json: str,\n        __event_call__=None,\n        __event_emitter__=None,\n        __request__=None,\n        __user__: Optional[dict] = None,\n    ) -> str:\n        \"\"\"\n        Run fixed steps without thinking between them. Prefer browser_agent loop instead.\n        \"\"\"\n\n        steps = json.loads(steps_json)\n        if not isinstance(steps, list) or not steps:\n            raise ValueError(\"steps_json must be a non-empty JSON array\")\n\n        results = []\n        last_page_text = \"\"\n\n        for i, step in enumerate(steps):\n            if not isinstance(step, dict):\n                raise ValueError(f\"Step {i} must be an object\")\n\n            response = await self.browser_agent(\n                thought=step.get(\"thought\", \"\"),\n                goal=step.get(\"goal\", \"\"),\n                action=step.get(\"action\", \"\"),\n                url=step.get(\"url\", \"\"),\n                query=step.get(\"query\", \"\"),\n                text=step.get(\"text\", \"\"),\n                selector=step.get(\"selector\", \"\"),\n                index=int(step.get(\"index\", -1)),\n                product_index=int(step.get(\"product_index\", 0)),\n                x=float(step.get(\"x\", -1)),\n                y=float(step.get(\"y\", -1)),\n                coordinate_system=step.get(\"coordinate_system\", \"normalized\"),\n                direction=step.get(\"direction\", \"down\"),\n                amount=int(step.get(\"amount\", 400)),\n                key=step.get(\"key\", \"Enter\"),\n                tab_id=int(step.get(\"tab_id\", 0)),\n                wait_ms=int(step.get(\"wait_ms\", 2500)),\n                clear=bool(step.get(\"clear\", False)),\n                engine=step.get(\"engine\", \"google\"),\n                value=step.get(\"value\", \"\"),\n                target=step.get(\"target\", \"auto\"),\n                __event_call__=__event_call__,\n                __event_emitter__=__event_emitter__,\n                __request__=__request__,\n                __user__=__user__,\n            )\n\n            parsed = json.loads(response)\n            if parsed.get(\"page_text\"):\n                last_page_text = parsed[\"page_text\"]\n            results.append(\n                {\"step\": i + 1, \"action\": step.get(\"action\"), \"result\": parsed}\n            )\n\n        return json.dumps(\n            {\n                \"steps_completed\": len(results),\n                \"results\": results,\n                \"final_page_text\": last_page_text,\n                \"model_instruction\": \"Answer using final_page_text or the last screenshot.\",\n            },\n            ensure_ascii=False,\n        )\n","specs":[{"name":"browser_agent","description":"YOU CONTROL the user's Chrome browser. You HAVE screenshot and click tools — use them.\nNEVER say you \"can only produce text\" or cannot execute browser tools — that is FALSE.\nNEVER ask the user to paste screenshots, questions, or page content.\n\nVision browser agent — ONE action per call. Uses screenshots for navigation (default).\n\nREQUIRES a vision-capable model. After each step a screenshot is attached for you to study.\n\nOn timeout/error: read model_instruction and call browser_agent again (ping → takeover → act).\n\nLOOP (required):\n1. THINK about the goal and the screenshot from the last step\n2. Call browser_agent with thought=\"...\" and ONE action\n3. Study the new screenshot in the tool result\n4. Repeat until agent_loop.task_done is true\n5. Only then answer the user\n\nQUIZ / \"solve\" goals: NEVER list answers in chat. Click each answer on the webpage with\nclick_at using quiz_options coordinates, then click Next/Submit. task_done only when\nquiz_submitted is true.\n\nSTART: action=takeover ONCE (user clicks website tab first). Screenshot auto-chains in the\nSAME tool call — do NOT call action=screenshot separately (causes session disconnect).\nAfter takeover, use click_at, dismiss_popups, scroll. NEVER call takeover again.\nWhen must_call_tool_before_reply or do_not_reply_to_user is true, your ONLY valid move is\nanother browser_agent call — explaining the plan to the user is forbidden.\n\nQuiz clicks (preferred on WWF/quiz pages):\n- action=solve_quiz_step, text=\"A\"  — BEST: select answer + click Next in one call\n- action=click_quiz_answer, text=\"A\"  — current question ONLY (then click_quiz_next)\n- quiz_options has distinct x,y per option — do NOT use 0.5,0.5 for all\n- NEVER use y>1.0 with normalized coords — values must be 0.0–1.0\n\nVision clicks:\n- action=click_at, x=0.42, y=0.18, coordinate_system=normalized\n- x,y are 0.0–1.0 fractions of the viewport (or use selector=...)\n\nOther actions: search, navigate, type, type_and_submit, scroll, wait, dismiss_popups\n\nScroll: many sites (WWF, Canvas) use inner scroll containers — scroll reports scroll_targets\nand scroll_containers. If window_delta is tiny, use click_at on visible options or press_key PageDown/Tab.\n\nText mode: set tool valve navigation_mode=text to use page_text instead of screenshots.","parameters":{"properties":{"thought":{"default":"","description":"Your reasoning BEFORE this action (required for multi-step tasks)","type":"string"},"action":{"default":"","description":"Single browser action to run","type":"string"},"goal":{"default":"","description":"Overall user goal (repeat each call until done)","type":"string"},"use_current_tab":{"default":false,"type":"boolean"},"url":{"default":"","type":"string"},"query":{"default":"","type":"string"},"text":{"default":"","type":"string"},"selector":{"default":"","type":"string"},"index":{"default":-1,"type":"integer"},"product_index":{"default":0,"type":"integer"},"x":{"default":-1,"description":"For click_at — horizontal position (see coordinate_system)","type":"number"},"y":{"default":-1,"description":"For click_at — vertical position (see coordinate_system)","type":"number"},"coordinate_system":{"default":"normalized","description":"normalized (0–1), permille (0–1000), or pixel","type":"string"},"direction":{"default":"down","type":"string"},"amount":{"default":400,"type":"integer"},"key":{"default":"Enter","type":"string"},"tab_id":{"default":0,"type":"integer"},"wait_ms":{"default":2500,"type":"integer"},"clear":{"default":false,"type":"boolean"},"engine":{"default":"google","type":"string"},"value":{"default":"","type":"string"},"target":{"default":"auto","type":"string"}},"type":"object"}},{"name":"browser_agent_run_steps","description":"Run fixed steps without thinking between them. Prefer browser_agent loop instead.","parameters":{"properties":{"steps_json":{"type":"string"}},"required":["steps_json"],"type":"object"}}]}]